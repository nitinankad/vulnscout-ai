PORT=3000
NODE_ENV=development

# PostgreSQL — e.g. postgres://user:password@localhost:5432/vulnscout
DATABASE_URL=postgres://postgres:postgres@localhost:5432/vulnscout

# Redis — e.g. redis://localhost:6379
REDIS_URL=redis://localhost:6379

# JWT — generate with: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=change-me-to-a-long-random-secret

# Encryption key for stored GitHub tokens (any long random string)
ENCRYPTION_KEY=change-me-to-a-long-random-secret

# GitHub OAuth App — create at: https://github.com/settings/developers → OAuth Apps → New
# Set callback URL to: http://localhost:3000/auth/github/callback (dev)
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_CALLBACK_URL=http://localhost:3000/auth/github/callback

# Frontend URL (used to redirect back after OAuth)
FRONTEND_URL=http://localhost:5173

# Anthropic API key — create at: https://console.anthropic.com/settings/api-keys
ANTHROPIC_API_KEY=
